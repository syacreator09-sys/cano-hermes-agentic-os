HERMES_ENV=development
HERMES_EXECUTION_MODE=dry_run
HERMES_DATABASE_URL=sqlite:///storage/hermes.db
HERMES_VAULT_PATH=vault
HERMES_AGENT_PATH=agents
HERMES_SKILL_PATH=skills
HERMES_ARTIFACT_PATH=storage/artifacts
HERMES_WORKTREE_PATH=storage/worktrees
HERMES_MAX_CONCURRENT_WORKERS=3
HERMES_DEFAULT_DAILY_BUDGET_USD=5.00
HERMES_REQUIRE_APPROVAL_FOR_PAID_API=true
HERMES_REQUIRE_APPROVAL_FOR_WRITES=true
HERMES_CLAUDE_COMMAND=claude
HERMES_CODEX_COMMAND=codex
HERMES_AGENT_COMMAND=hermes
HERMES_OPENCLAW_COMMAND=openclaw

# Providers: leave empty until configured on the Ubuntu host.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
XAI_API_KEY=
