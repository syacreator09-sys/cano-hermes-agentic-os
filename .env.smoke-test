# StarHome OS — entorno de smoke test (K16 iteracion 1)
# Uso: HERMES_ENV_FILE=/home/cano/repos/cano-hermes-agentic-os/.env.smoke-test python -m uvicorn cano_hermes.api.app:app
#       o bien: export $(grep -v '^#' .env.smoke-test | xargs) && python scripts/validate.py
#
# PRINCIPIO: cero gasto real, cero transacciones en produccion.
# Este archivo desactiva todas las pasarelas de pago y pone el sistema en
# modo simulado (dry_run). Ninguna orden de prueba generara cargo.

HERMES_ENV=smoke-test
HERMES_EXECUTION_MODE=dry_run
HERMES_DATABASE_URL=sqlite:///storage/hermes-smoke.db
HERMES_VAULT_PATH=vault
HERMES_AGENT_PATH=agents
HERMES_SKILL_PATH=skills
HERMES_ARTIFACT_PATH=storage/artifacts-smoke
HERMES_WORKTREE_PATH=storage/worktrees-smoke
HERMES_MAX_CONCURRENT_WORKERS=1
HERMES_DEFAULT_DAILY_BUDGET_USD=0.00
HERMES_REQUIRE_APPROVAL_FOR_PAID_API=true
HERMES_REQUIRE_APPROVAL_FOR_WRITES=true
HERMES_CLAUDE_COMMAND=claude
HERMES_CODEX_COMMAND=codex
HERMES_AGENT_COMMAND=hermes
HERMES_OPENCLAW_COMMAND=openclaw

# Kanban board dedicado para smoke test (no mezclar con produccion)
# Nota: kanban_bridge.py usa el board "starhome" por defecto; para un
# smoke test aislado se puede sobreescribir via variable de entorno
# STARHOME_KANBAN_BOARD=starhome-smoke (requiria cambio menor en codigo)
# Hoy se deja como "starhome" porque kanban_bridge.py no lee env var.

# ---------------------------------------------------------------------------
# PASARELAS DE PAGO — SOLO TEST/SANDBOX, NUNCA LIVE
# ---------------------------------------------------------------------------
# Stripe: se mantienen SOLO las claves de test (pk_test_/sk_test_).
# Las claves live se eliminan explicitamente de este entorno.
STRIPE_PUBLISHABLE_KEY=pk_test_51Mle1LDzAt5gJU5pIVrIGDSW9xeDkz5noXMNFUcfNnsLAFpBRna4Xctv7r7tqmxDoR5DhLM6vhzrzLxCYiHFTyO700jjFy4dW1
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY_LIVE=
STRIPE_SECRET_KEY_LIVE=
STRIPE_MVP_PRICE_ID=price_1TKiiPDzAt5gJU5pe2WXWWmb
STRIPE_VIP_PRICE_ID=price_1TKiiVDzAt5gJU5pwp7eTAMV

# Twilio: solo credenciales de test
TWILIO_ACCOUNT_SID=ACSMOKETESTNOTREALNOTREALPLACEHOLD
TWILIO_AUTH_TOKEN=smoketestauthtokennotarealplacehold
TWILIO_TEST_ACCOUNT_SID=ACSMOKETESTNOTREALNOTREALPLACEHOLD
TWILIO_TEST_AUTH_TOKEN=smoketestauthtokennotarealplacehold

# ---------------------------------------------------------------------------
# PROVEEDORES LLM / API — VACIOS O TEST EN SMOKETEST
# ---------------------------------------------------------------------------
# En modo dry_run los ejecutores nunca llegan a llamar a estos endpoints,
# pero por defensa en profundidad se dejan vacios o con valores dummy.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
XAI_API_KEY=
KIMI_API_KEY=
OPENROUTER_API_KEY=

# ElevenLabs, Modal, etc. — vacios en smoke test
ELEVENLABS_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# NOTIFICACIONES Y BRIDGE
# ---------------------------------------------------------------------------
# Telegram: se puede dejar vacio para evitar spam durante smoke test
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# HMAC del bridge: se usa un secreto de test distinto al de prod
STARHOME_BRIDGE_HMAC_SECRET=smoke-test-secret-only-for-local-tests-do-not-use-in-prod

# ---------------------------------------------------------------------------
# SERVICIOS EXTERNOS — DESACTIVADOS O APUNTANDO A STAGING
# ---------------------------------------------------------------------------
# Baserow: si existe una instancia de staging, apuntar aqui; si no, vacio
BASEROW_API_URL=
BASEROW_API_TOKEN=

# Supabase: staging o vacio
SUPABASE_ORION_URL=
SUPABASE_ORION_ANON_KEY=
SUPABASE_ORION_SERVICE_KEY=

# n8n: staging o vacio
N8N_HOST=
N8N_API_KEY=
N8N_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# FLAGS EXPLICITAS DE MODO MOCK/STAGING
# ---------------------------------------------------------------------------
ENVIRONMENT=smoke-test
SMOKE_TEST=true
