.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
node_modules/
dist/
build/
*.egg-info/
.DS_Store
storage/*.db
storage/*.sqlite*
storage/logs/*
storage/artifacts/*
storage/worktrees/*
storage/workspaces/*
storage/forge/candidates/*
storage/forge/sandbox/*
!storage/.gitkeep
!storage/logs/.gitkeep
!storage/artifacts/.gitkeep
!storage/worktrees/.gitkeep
!storage/workspaces/.gitkeep
!storage/forge/.gitkeep
vault/.obsidian/workspace*.json
vault/00-inbox/private/
secrets/
*.pem
*.key

# F10 media output — binaries stay local, only reports/ .md + ffprobe text are tracked
reports/media/

# F11 — Docker infra: office run artifacts (task/hermes output, usage files)
# and any plaintext secret handoff files stay local, never committed.
infrastructure/offices/data/*/output/*
infrastructure/offices/data/*/reports/*
!infrastructure/offices/data/*/output/.gitkeep
!infrastructure/offices/data/*/reports/.gitkeep
infrastructure/baserow/baserow_api_token.txt
infrastructure/baserow/data/
